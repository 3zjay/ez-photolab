{
  "name": "photolab",
  "description": "PHOTOlab photo editor for web and Windows",
  "author": "PHOTOlab",
  "private": true,
  "version": "2.10.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:build": "vite build --mode desktop",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --dir --publish never",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:desktop:smoke": "node scripts/desktop-smoke.mjs",
    "test:web:smoke": "node scripts/web-smoke.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@imgly/background-removal": "^1.4.5",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@xenova/transformers": "^2.17.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "libraw-wasm": "^1.1.2",
    "onnxruntime-web": "1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "vite": "^5.4.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
