{
  "name": "photolab",
  "description": "PHOTOlab photo editor for web and Windows",
  "author": "PHOTOlab",
  "private": true,
  "version": "2.10.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 3000",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "desktop:build": "node node_modules/vite/bin/vite.js build --mode desktop",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && node node_modules/electron-builder/cli.js --dir --publish never",
    "desktop:dist": "npm run desktop:build && node node_modules/electron-builder/cli.js --win nsis --x64 --publish never",
    "test:desktop": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:desktop:smoke": "node scripts/desktop-smoke.mjs",
    "test:web:smoke": "node scripts/web-smoke.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@imgly/background-removal": "^1.4.5",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@xenova/transformers": "^2.17.2",
    "canvas-confetti": "^1.9.4",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.1.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.11",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
